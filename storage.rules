
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files by default.
    // This allows the AI and the app to easily access generated images and audio files.
    match /{allPaths=**} {
      allow read;
    }

    // Secure the recordings folder.
    // Only allow writes if the user is authenticated (including anonymous users).
    // This prevents unauthenticated users from uploading files.
    match /recordings/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
