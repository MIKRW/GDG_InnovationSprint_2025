
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all files.
    // This is safe because file paths are unguessable UUIDs.
    match /{allPaths=**} {
      allow read;
    }

    // Recordings can only be created by authenticated users.
    // The path includes a recordingId which is a UUID, ensuring no overlap.
    match /recordings/{recordingId}.webm {
      allow write: if request.auth != null;
    }
  }
}
