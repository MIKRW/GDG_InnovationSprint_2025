
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read and write access to the recordings folder for anonymous uploads.
    match /recordings/{allPaths=**} {
      allow read, write: if true;
    }

    // By default, all other paths require authentication.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
